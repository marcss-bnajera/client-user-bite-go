# ============================================================================
# Bite&Go Client (Usuario) - Variables de entorno
# ============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# Estas variables son públicas (VITE_*) y se empaquetan en el build.
# ============================================================================

# URL del auth-service (.NET) — para login/registro
VITE_AUTH_URL=http://localhost:3000

# URL del user-service (Node.js) — para restaurantes, pedidos, etc.
VITE_API_URL=http://localhost:3001/bite-and-go/v1
